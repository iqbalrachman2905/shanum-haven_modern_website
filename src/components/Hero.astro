---
import { formatRupiah, buildWaLink } from '../lib/format.js';

const { content, heroImageResult, availableUnits, totalUnits } = Astro.props;

const waMessage = `Halo, saya tertarik dengan ${content.hero_title || 'properti ini'}. Boleh info lebih lanjut?`;
const waLink = buildWaLink(content.whatsapp_number, waMessage);
---

<section class="hero">
  {heroImageResult && (
    <img
      src={heroImageResult.src}
      srcset={heroImageResult.srcSet?.attribute}
      sizes="100vw"
      alt={content.hero_title || 'Foto cluster'}
      loading="eager"
      fetchpriority="high"
      class="hero-bg"
    />
  )}
  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="container hero-content">
    {content.badge_text && <span class="hero-badge glass--hero">{content.badge_text}</span>}

    {availableUnits !== undefined && availableUnits !== null && (
      <div class="scarcity-badge glass--hero">
        <svg class="scarcity-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
        Tersisa <strong>{availableUnits}</strong> dari {totalUnits} unit!
      </div>
    )}


    <h1 class="hero-title">{content.hero_title}</h1>
    {content.hero_subtitle && <p class="hero-subtitle">{content.hero_subtitle}</p>}

    <div class="hero-price-card glass--hero">
      <span class="hero-price-label">Harga mulai</span>
      <span class="hero-price">{formatRupiah(content.price_from)}</span>
      <div class="hero-promo">
        {content.promo_dp && <span class="promo-chip">{content.promo_dp}</span>}
        {content.promo_booking && <span class="promo-chip">{content.promo_booking}</span>}
      </div>
    </div>

    <div class="hero-stats glass--hero">
      {content.total_unit && <div class="stat"><strong>{content.total_unit}</strong><span>Unit</span></div>}
      {content.jumlah_lantai && <div class="stat"><strong>{content.jumlah_lantai} Lantai</strong></div>}
      {content.jarak_lrt && <div class="stat"><strong>{content.jarak_lrt}</strong></div>}
      {content.jarak_tol && <div class="stat"><strong>{content.jarak_tol}</strong></div>}
    </div>

    <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-wa glass--hero">
      Booking via WhatsApp
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--color-primary);
  }
  .hero-bg,
  .hero-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-overlay {
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-primary) 92%, transparent) 0%,
      color-mix(in srgb, var(--color-primary) 55%, transparent) 45%,
      color-mix(in srgb, var(--color-primary) 15%, transparent) 100%
    );
  }
  .hero-content {
    position: relative;
    z-index: 1;
    color: var(--color-bg-main);
    padding-block: var(--space-xl) var(--space-lg);
  }
  .hero-badge {
    display: inline-block;
    background: var(--glass-bg-hero);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--glass-border-hero);
    color: var(--color-bg-main);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 16px;
    border-radius: 999px;
    margin-bottom: var(--space-sm);
  }
  .scarcity-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(184, 147, 95, 0.35);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border: 1px solid rgba(184, 147, 95, 0.3);
    color: var(--color-bg-main);
    font-weight: 700;
    font-size: 0.95rem;
    padding: 8px 18px;
    border-radius: 999px;
    margin-bottom: var(--space-sm);
    animation: pulse-scarcity 2s ease-in-out infinite;
  }
  .scarcity-icon {
    flex-shrink: 0;
  }
  @keyframes pulse-scarcity {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-status-sold) 40%, transparent); }
    50% { box-shadow: 0 0 0 8px color-mix(in srgb, var(--color-status-sold) 0%, transparent); }
  }
  .hero-title {
    font-size: clamp(2.2rem, 6vw, 4rem);
    margin-bottom: var(--space-xs);
    max-width: 20ch;
  }
  .hero-subtitle {
    font-size: 1.15rem;
    color: color-mix(in srgb, var(--color-bg-main) 85%, transparent);
    margin-bottom: var(--space-md);
  }
  .hero-price-card {
    background: var(--glass-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    color: var(--color-primary);
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-md);
    box-shadow: var(--glass-shadow);
    margin-bottom: var(--space-md);
  }
  .hero-price-label {
    font-size: 0.8rem;
    color: var(--color-navy-soft);
  }
  .hero-price {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-primary);
  }
  .hero-promo {
    display: flex;
    gap: 8px;
    margin-top: 4px;
    flex-wrap: wrap;
  }
  .promo-chip {
    background: var(--color-gold-soft);
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 999px;
  }
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-md);
  }
  .stat {
    display: flex;
    flex-direction: column;
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--color-bg-main) 85%, transparent);
    padding-right: var(--space-md);
    border-right: 1px solid var(--glass-border-hero);
  }
  .stat:last-child {
    border-right: none;
    padding-right: 0;
  }
  .stat strong {
    font-size: 1.1rem;
    color: var(--color-bg-main);
  }
  .btn-wa {
    display: inline-block;
    background: var(--color-secondary);
    color: var(--color-primary);
    font-weight: 600;
    padding: 14px 32px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    box-shadow: var(--glass-shadow);
    border: 1px solid rgba(184, 147, 95, 0.3);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .btn-wa:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(184, 147, 95, 0.25);
  }
</style>
