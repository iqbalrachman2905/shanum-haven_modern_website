---
import { getImage } from 'astro:assets';
import GalleryLightbox from './GalleryLightbox.vue';

const { gallery } = Astro.props;

const raw = gallery
  .filter(g => g.kategori === 'facility' && g.thumbnail_url)
  .sort((a, b) => (a.urutan || 0) - (b.urutan || 0));

// Proses build-time (sama pipeline kayak <Image>), tapi hasilnya URL string
// biasa - supaya bisa dilempar ke komponen Vue client-side buat lightbox.
const items = await Promise.all(raw.map(async (item) => {
  const thumb = await getImage({
    src: item.thumbnail_url,
    inferSize: true,
    width: 400,
    format: 'webp',
    quality: 72
  });
  const full = await getImage({
    src: item.thumbnail_url,
    inferSize: true,
    width: 1200,
    format: 'webp',
    quality: 82
  });
  return {
    id: item.id,
    thumbSrc: thumb.src,
    fullSrc: full.src,
    caption: item.caption
  };
}));
---

<section id="fasilitas" class="facilities-section">
  <div class="container">
    <div class="section-heading">
      <span class="eyebrow">Fasilitas</span>
      <h2>Fasilitas Premium untuk Keluarga</h2>
    </div>

    <GalleryLightbox items={items} client:visible />
  </div>
</section>

<style>
  .facilities-section {
    padding-block: var(--space-xl);
    background: var(--color-bg-paper);
  }
  .section-heading {
    text-align: center;
    margin-bottom: var(--space-lg);
  }
  .eyebrow {
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-secondary);
    margin-bottom: 6px; /* 6px untuk jarak micro-spacing bisa dipertahankan atau diganti var(--space-xs) */
  }
  .section-heading h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }
</style>
