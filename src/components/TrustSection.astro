---
const { content, testimonials } = Astro.props;

const trustPoints = [content.trust_points_1, content.trust_points_2, content.trust_points_3]
  .filter(Boolean);
const bankPartners = content.bank_partner
  ? String(content.bank_partner).split(',').map(b => b.trim()).filter(Boolean)
  : [];
---

{(trustPoints.length > 0 || testimonials.length > 0) && (
  <section id="trust" class="trust-section">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">Kenapa Percaya Kami</span>
        <h2>Dipercaya Ratusan Calon Pemilik Rumah</h2>
      </div>

      {trustPoints.length > 0 && (
        <div class="trust-points">
          {trustPoints.map((point) => (
            <div class="trust-point">
              <span class="trust-check">✓</span>
              <span>{point}</span>
            </div>
          ))}
        </div>
      )}

      {bankPartners.length > 0 && (
        <div class="bank-partners">
          <span class="bank-label">Partner KPR:</span>
          {bankPartners.map((bank) => (
            <span class="bank-badge">{bank}</span>
          ))}
        </div>
      )}

      {testimonials.length > 0 && (
        <div class="testimonial-grid">
          {testimonials.map((t) => (
            <div class="testimonial-card">
              {t.rating && (
                <div class="testimonial-rating" aria-label={`Rating ${t.rating} dari 5`}>
                  {'★'.repeat(Number(t.rating))}{'☆'.repeat(5 - Number(t.rating))}
                </div>
              )}
              <p class="testimonial-text">"{t.text}"</p>
              <span class="testimonial-name">{t.name}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>
)}

<style>
  .trust-section {
    padding-block: var(--space-xl);
  }
  .section-heading {
    text-align: center;
    margin-bottom: var(--space-lg);
  }
  .eyebrow {
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-gold);
    margin-bottom: 6px;
  }
  .section-heading h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }
  .trust-points {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }
  .trust-point {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: var(--color-paper);
    border-radius: var(--radius-md);
    padding: var(--space-sm);
    font-size: 0.92rem;
  }
  .trust-check {
    color: var(--color-status-available);
    font-weight: 700;
    flex-shrink: 0;
  }
  .bank-partners {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    justify-content: center;
    margin-bottom: var(--space-lg);
  }
  .bank-label {
    font-size: 0.85rem;
    color: var(--color-navy-soft);
  }
  .bank-badge {
    background: var(--color-navy);
    color: var(--color-white);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 6px 16px;
    border-radius: 999px;
  }
  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-md);
  }
  .testimonial-card {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: var(--space-md);
  }
  .testimonial-rating {
    color: var(--color-gold);
    letter-spacing: 2px;
    margin-bottom: 8px;
  }
  .testimonial-text {
    font-style: italic;
    color: var(--color-navy-soft);
    margin-bottom: var(--space-sm);
    line-height: 1.6;
  }
  .testimonial-name {
    font-weight: 600;
    color: var(--color-navy);
    font-size: 0.9rem;
  }
</style>
